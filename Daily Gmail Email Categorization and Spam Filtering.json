        "message": "=<h2>📧 Daily Email Categorization Report</h2>\n<p><strong>Date:</strong> {{ $now.format(\"MMMM d, yyyy\") }}</p>\n<p><strong>Time:</strong> {{ $now.format(\"h:mm a\") }}</p>\n\n<h3>📊 Summary:</h3>\n<ul>\n<li><strong>Total Emails Processed:</strong> {{ $('Route by Category').all().length }}</li>\n<li><strong>🚫 Spam:</strong> {{ $('Route by Category').all().filter(item => item.json.output.category === \"spam\").length }}</li>\n<li><strong>💼 Job Related:</strong> {{ $('Route by Category').all().filter(item => item.json.output.category === \"job\").length }}</li>\n<li><strong>📚 Educational:</strong> {{ $('Route by Category').all().filter(item => item.json.output.category === \"educational\").length }}</li>\n</ul>\n\n<h3>📋 Detailed Results:</h3>\n<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%;\">\n<tr style=\"background-color: #f2f2f2;\">\n<th>From</th>\n<th>Subject</th>\n<th>Category</th>\n<th>Confidence</th>\n</tr>\n{{ $('Route by Category').all().map(item => `<tr>\n<td>${item.json.output.from || \"N/A\"}</td>\n<td>${item.json.output.subject || \"N/A\"}</td>\n<td>${item.json.output.category}</td>\n<td>${(item.json.output.confidence * 100).toFixed(0)}%</td>\n</tr>`).join(\"\") }}\n</table>\n\n<p style=\"margin-top: 20px;\"><em>All emails have been automatically labeled in your Gmail account.</em></p>",
