    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this email and categorize it:\n\nFrom: {{ $json.From }}\nSubject: {{ $json.Subject }}\nBody: {{ $json.snippet }}\n\nEmail ID: {{ $json.id }}\n\nIMPORTANT: Include the From and Subject in your response for reporting purposes.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an email categorization assistant. Your task is to analyze emails and categorize them into one of three categories:\n\n1. SPAM - Unsolicited promotional emails, phishing attempts, suspicious content, or irrelevant messages\n2. job - Job offers, recruitment emails, career opportunities, interview invitations, or professional networking\n3. educational - Course materials, learning resources, academic content, training programs, or educational newsletters\n\nAnalyze the email content carefully and return:\n- category: one of spam, job, or educational\n- emailId: the email ID provided\n- confidence: your confidence level (0-1)\n- from: the sender email address\n- subject: the email subject line\n\nIf you need to add labels to emails, use the Gmail Tool to apply the appropriate label."
        }
      },
      "id": "5f4cce14-86e0-4680-9dfd-50fdc75e6010",
      "name": "Email Categorization Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        48,
        624
      ]
    },
    {
      "parameters": {
